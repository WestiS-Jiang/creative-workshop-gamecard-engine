# Provider switch: OPENAI_COMPAT | GEMINI
LLM_PROVIDER=OPENAI_COMPAT

# OPENAI_COMPAT example: https://api.openai.com/v1
# GEMINI example: https://generativelanguage.googleapis.com/v1beta
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here

# Default model fallback
LLM_MODEL=gpt-4.1-mini

# Optional per-task model override (JSON)
# Tasks: MAP_EVENT_EXTRACTION, MAP_RULE_PROBING, CRA_PATCH, MAIN_LOOP_TURN
LLM_TASK_MODELS={"CRA_PATCH":"gpt-4.1","MAIN_LOOP_TURN":"gpt-4.1-mini"}

# Optional visual generation providers. Leave empty unless explicitly configured.
VISUAL_QWEN_VL_URL=
VISUAL_QWEN_VL_MODEL=Qwen2-VL-72B-Instruct
VISUAL_QWEN_VL_KEY=
VISUAL_IMAGE_PROVIDER=OPENAI_COMPAT
VISUAL_IMAGE_API_URL=
VISUAL_IMAGE_API_KEY=
VISUAL_IMAGE_URL_REWRITE_FROM=
VISUAL_IMAGE_URL_REWRITE_TO=
